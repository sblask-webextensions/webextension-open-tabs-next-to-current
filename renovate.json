{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "minimumReleaseAge": "1 week",
    "packageRules": [
        {
            "automerge": true,
            "automergeType": "branch",
            "groupName": "actions",
            "matchPackageNames": [
                "actions/*"
            ]
        },
        {
            "automerge": true,
            "automergeType": "branch",
            "extends": [
                "schedule:monthly"
            ],
            "groupName": "eslint",
            "matchPackageNames": [
                "@eslint/js",
                "@stylistic/eslint-plugin",
                "eslint"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ]
        },
        {
            "automerge": true,
            "automergeType": "branch",
            "extends": [
                "schedule:monthly"
            ],
            "matchPackageNames": [
                "editorconfig-checker/editorconfig-checker.python",
                "globals",
                "rhysd/actionlint",
                "web-ext"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ]
        }
    ],
    "pre-commit": {
        "enabled": true
    }
}
